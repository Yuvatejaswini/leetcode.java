//75. Sort Colors
class Solution {
    public void sortColors(int[] nums) {
        int rcount = 0;
        int wcount = 0; 
        int bcount = 0;
        for (int num : nums) {
            if (num == 0) rcount++;
            else if (num == 1) wcount++;
            else bcount++;
        }
        int index = 0;
        for (int i = 0; i < rcount; i++) {
            nums[index++] = 0;
        }
        for (int i = 0; i < wcount; i++) {
            nums[index++] = 1;
        }
        for (int i = 0; i < bcount; i++) {
            nums[index++] = 2;
        }
    }
}
